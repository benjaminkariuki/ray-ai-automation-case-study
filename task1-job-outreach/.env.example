# Copy to .env (never commit .env) for local runs. In GitHub Actions these are repository secrets.

# The Google Sheet ID: the long code in the sheet URL between /d/ and /edit
SHEET_ID=

# Google service account with access to the sheet (share the sheet with its email as Editor).
# Locally: path to the JSON key file.  In GitHub Actions: GOOGLE_SERVICE_ACCOUNT_JSON = the file's full content.
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Primary AI - https://openrouter.ai/settings/keys (free account works)
OPENROUTER_API_KEY=

# Backup AI - Cloudflare Workers AI (free): account ID from the dashboard,
# token from https://dash.cloudflare.com/profile/api-tokens using the "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
