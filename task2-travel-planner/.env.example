# Copy to .env for local runs (never commit .env). In GitHub Actions: secret NOTION_TOKEN, variable NOTION_DATA_SOURCE_ID.

# Internal integration secret from https://www.notion.so/profile/integrations (capabilities: read, update, insert)
NOTION_TOKEN=

# Only for "python -m planner build": the page the integration is connected to
NOTION_PAGE_URL=

# Printed by "build" and saved in workspace.json (optional here if workspace.json exists)
NOTION_DATA_SOURCE_ID=
